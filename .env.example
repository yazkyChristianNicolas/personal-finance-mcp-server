SERVER_NAME=mcp-personal-finance-server
SERVER_URL=http://localhost:8000

# Resource server (confidential client) — realm compartido con personal-finance-service
KEYCLOAK_REALM_URL=http://localhost:8080/realms/personal-finance
KEYCLOAK_CLIENT_ID=mcp-personal-finance-server
KEYCLOAK_CLIENT_SECRET=

# Solo si el MCP corre en el mismo docker-compose que Keycloak (URL interna != pública)
# KEYCLOAK_PUBLIC_URL=http://localhost:8080/realms/personal-finance

# Client M2M — para que las tools distingan al agente headless de un usuario humano
MCP_AGENT_CLIENT_ID=mcp-personal-finance-agent

# API de personal-finance-service que envuelven las tools
UPSTREAM_API_BASE_URL=http://localhost:3000
# Personal Finance API Key — SOLO la usa el agente M2M (no tiene usuario real detrás
# de su token). Generarla con POST /api-keys autenticado como un usuario real.
UPSTREAM_API_KEY=
